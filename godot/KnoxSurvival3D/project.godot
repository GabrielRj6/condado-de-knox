; Engine configuration file.
; Configured for Godot 4.3+ (Forward Plus / Vulkan GPU + Multi-core CPU).

config_version=5

[application]

config/name="Knox Survival 3D (Radmin)"
config/description="Sobrevivencia 3D multiplayer com som espacial 3D, carros, motos, zumbis e mapas reais via Radmin VPN."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=1

[rendering]

driver/threads/thread_model=1
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/directional_shadow/size=2048
anti_aliasing/quality/msaa_3d=1
