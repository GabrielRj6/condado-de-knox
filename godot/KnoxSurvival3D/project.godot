; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Knox Survival 3D (Radmin)"
config/description="Sobrevivencia 3D multiplayer com som espacial 3D, carros, motos, zumbis e mapas reais via Radmin VPN."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[rendering]

lights_and_shadows/directional_shadow/size=2048
anti_aliasing/quality/msaa_3d=1
occlusion_culling/use_occlusion_culling=true
